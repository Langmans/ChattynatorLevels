{
    "flavors": ["mainline", "forever", "classic_era"],
    "library": ["annotations/"],
    "ignore": ["tests/", "coverage/", "Libs/", ".lua/", ".luarocks/", ".busted", ".luacov", "*.rockspec"],
    "diagnostics": {
        "enable": [
            "need-check-nil",
            "unknown-local-type",
            "unknown-param-type",
            "unknown-return-type",
            "unknown-field-type",
            "incomplete-signature-doc"
        ],
        "severity": {
            "unknown-local-type": "warning",
            "unknown-param-type": "warning",
            "unknown-return-type": "warning",
            "unknown-field-type": "warning",
            "incomplete-signature-doc": "warning"
        }
    }
}
